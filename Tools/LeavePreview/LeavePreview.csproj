<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
    <ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../RemoteWork.WinForms/RemoteWork.WinForms.csproj" /></ItemGroup>
  <ItemGroup>
    <Compile Update="LeavePreviewForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="LeavePreviewForm.Designer.cs"><DependentUpon>LeavePreviewForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="LeavePreviewForm.resx"><DependentUpon>LeavePreviewForm.cs</DependentUpon></EmbeddedResource>
  </ItemGroup>
</Project>
