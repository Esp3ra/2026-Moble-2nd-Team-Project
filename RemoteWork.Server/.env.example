# Copy to .env. Use a dedicated database and account (see docs/SETUP.md).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=remote_work
MYSQL_USER=remote_work
MYSQL_PASSWORD=CHANGE_ME
# Optional alternative; percent-encode special characters in a URL password.
# DATABASE_URL=mysql+pymysql://remote_work:password@127.0.0.1:3306/remote_work?charset=utf8mb4
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SESSION_HOURS=8
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=5000
COMPANY_NAME=회사명

# W1 common write-support draft: opt in only in a reviewed dedicated development DB.
# REMOTEWORK_ENABLE_COMMON_WRITE_DRAFT=1
# Candidate/write-context routes also require the existing task-query opt-in.
# REMOTEWORK_ENABLE_TASK_QUERY_DRAFT=1
# Separate explicit read-only lifecycle receipts after disabling lifecycle writes.
# Requires reviewed existing 009 storage; never creates DDL or acknowledges integration.
# REMOTEWORK_ENABLE_TASK_LIFECYCLE_RESULT_READS_DRAFT=1
# Approved default: key execution window / success-result retention (seconds).
# WRITE_REQUEST_TTL_SECONDS=86400

# Chat API/model registration is a development draft, default off.
# Shared API/DDL approval is separate. Init-Chat enables only its own process.
REMOTEWORK_ENABLE_CHAT_DRAFT=0

# Popup split/name accepted by member 1; default off. DDL/retention/shared rollout still under review.
REMOTEWORK_ENABLE_NOTICE_POPUP_DRAFT=0
# Fingerprint enrollment: independent MySQL development draft, default off.
REMOTEWORK_ENABLE_DEVICE_ENROLLMENT_DRAFT=0
# MySQL-only physical intent/result API. Review 010 and migrate the Pi client first.
# Default off; never enable against an old SQLite-backed writer.
REMOTEWORK_ENABLE_ENROLLMENT_DURABILITY_DRAFT=0
# Explicit operator recovery/reissue, requires BOTH enrollment flags above and 011.
# No HTTP slot-empty assertion, automatic cleanup or sensor deletion.
REMOTEWORK_ENABLE_ENROLLMENT_RECOVERY_DRAFT=0
# Private server-only JSON outside this checkout. See docs/DEVICE_ENROLLMENT_API.md.
# REMOTEWORK_ENROLLMENT_KEYS_FILE=

# RW-ID-v2 identity service: NOT the enrollment switch. Keep 0 on shared servers.
# 1 alone fails startup: explicit private profile/exclusion map + trusted current
# attendance reader and separate reviewed schema are required. Finalize still 503.
# Existing API/web normal login and old work sessions are blocked while enabled.
REMOTEWORK_ENABLE_DEVICE_IDENTITY_DRAFT=0
